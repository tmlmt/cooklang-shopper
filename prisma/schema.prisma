generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model RecipeVisibility {
  id         Int      @id @default(autoincrement())
  recipePath String   @unique
  visibility String   // "public" or "private"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ShareLink {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  recipePath String
  locale     String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([recipePath])
}

model ShoppingListShareLink {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userKey   String
  listName  String    @default("")
  ownerName String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userKey, listName])
}

model User {
  id          Int            @id @default(autoincrement())
  email       String         @unique
  displayName String?
  role        String // "viewer" | "editor" | "admin"
  status      String // "invited" | "active"
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  identities  UserIdentity[]
  invitations Invitation[]
}

model UserIdentity {
  id        Int      @id @default(autoincrement())
  userId    Int
  provider  String // "google" | "microsoft"
  subject   String // Google sub / Microsoft subject
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model Invitation {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
