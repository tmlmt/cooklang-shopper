{
  "name": "@tmlmt/cooklang-shopper",
  "version": "0.20.9",
  "description": "Shopping list and cart manager for cooklang recipes",
  "author": "Thomas Lamant <tom@tmlmt.com>",
  "packageManager": "pnpm@12.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "dev": "nuxt dev",
    "format": "prettier --loglevel warn --config .prettierrc --write \"{app,server,shared,test}/**/*.{ts,vue,mjs}\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "translation:upload": "crowdin upload",
    "translation:download": "crowdin download translations && pnpm translation:status",
    "translation:status": "node scripts/update-translation-status.mjs",
    "admin:code": "node scripts/admin-code.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "pnpx skilld prepare || true"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/robots": "7.0.2",
    "@nuxtjs/sitemap": "9.1.0",
    "@pinia/nuxt": "1.0.3",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@takumi-rs/core": "2.16.3",
    "@tmlmt/cooklang-parser": "3.0.0-alpha.47",
    "@vue/devtools-api": "8.2.1",
    "better-sqlite3": "13.0.3",
    "c12": "4.0.0-rc.2",
    "fuse.js": "7.5.0",
    "glob": "13.0.6",
    "h3": "1.15.11",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "nodemailer": "10.1.2",
    "nuxt": "4.6.2",
    "nuxt-auth-utils": "0.5.32",
    "nuxt-i18n-micro": "3.30.1",
    "nuxt-security": "2.6.0",
    "nuxt-seo-utils": "9.0.1",
    "pinia": "4.1.0",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@iconify-json/lucide": "1.2.145",
    "@iconify-json/material-symbols": "1.2.95",
    "@iconify-json/prime": "1.2.5",
    "@nuxt/devtools": "3.4.3",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/test-utils": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/turndown": "5.0.6",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "execa": "10.1.1",
    "human-regex": "2.2.0",
    "nitropack": "2.13.4",
    "nuxt-og-image": "7.0.7",
    "nuxtseo-devtools-host": "1.0.2",
    "nuxtseo-layer-devtools": "6.0.2",
    "openai": "7.36.0",
    "prettier": "3.9.10",
    "prisma": "7.9.1",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
