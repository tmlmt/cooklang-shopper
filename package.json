{
  "name": "@tmlmt/cooklang-shopper",
  "version": "0.20.7",
  "description": "Shopping list and cart manager for cooklang recipes",
  "author": "Thomas Lamant <tom@tmlmt.com>",
  "packageManager": "pnpm@11.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=4096 nuxt build",
    "dev": "nuxt dev",
    "format": "prettier --loglevel warn --config .prettierrc --write \"{app,server,shared,test}/**/*.{ts,vue,mjs}\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "translation:upload": "crowdin upload",
    "translation:download": "crowdin download translations && pnpm translation:status",
    "translation:status": "node scripts/update-translation-status.mjs",
    "admin:code": "node scripts/admin-code.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "pnpx skilld prepare || true"
  },
  "dependencies": {
    "@internationalized/date": "3.12.3",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.10.0",
    "@nuxtjs/robots": "6.1.3",
    "@nuxtjs/sitemap": "8.3.3",
    "@pinia/nuxt": "1.0.1",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "@takumi-rs/core": "2.5.9",
    "@tmlmt/cooklang-parser": "3.0.0-alpha.45",
    "@vue/devtools-api": "8.2.1",
    "better-sqlite3": "13.0.3",
    "c12": "4.0.0-beta.5",
    "fuse.js": "7.5.0",
    "glob": "13.0.6",
    "h3": "1.15.11",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "nodemailer": "^9.0.4",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-i18n-micro": "3.28.0",
    "nuxt-security": "2.6.0",
    "nuxt-seo-utils": "8.3.3",
    "pinia": "4.0.2",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@iconify-json/lucide": "1.2.121",
    "@iconify-json/material-symbols": "1.2.88",
    "@iconify-json/prime": "1.2.5",
    "@nuxt/devtools": "3.4.1",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/test-utils": "4.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/turndown": "5.0.6",
    "@vueuse/core": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "eslint": "10.8.0",
    "eslint-plugin-tailwindcss": "4.2.0",
    "execa": "10.0.1",
    "human-regex": "2.2.0",
    "nitropack": "2.13.4",
    "nuxt-og-image": "6.7.6",
    "nuxtseo-layer-devtools": "5.3.10",
    "openai": "7.4.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.9"
  }
}
