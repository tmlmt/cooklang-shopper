{
  "name": "@tmlmt/cooklang-shopper",
  "version": "0.7.3",
  "description": "Shopping list and cart manager for cooklang recipes",
  "author": "Thomas Lamant <tom@tmlmt.com>",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier --loglevel warn --config .prettierrc --write \"{app,server,shared,test}/**/*.{ts,vue,mjs}\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "4.6.0",
    "@pinia/nuxt": "0.11.3",
    "@prisma/adapter-better-sqlite3": "7.7.0",
    "@prisma/client": "7.7.0",
    "@tmlmt/cooklang-parser": "3.0.0-alpha.25",
    "better-sqlite3": "12.8.0",
    "c12": "4.0.0-beta.4",
    "fuse.js": "7.3.0",
    "glob": "13.0.6",
    "h3": "1.15.10",
    "nuxt": "4.4.2",
    "nuxt-auth-utils": "0.5.29",
    "pinia": "3.0.4",
    "tailwindcss": "4.2.2",
    "valibot": "1.3.1",
    "vue": "3.5.31"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "1.2.64",
    "@iconify-json/prime": "1.2.4",
    "@nuxt/devtools": "3.2.4",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/hints": "1.0.2",
    "@nuxt/test-utils": "4.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@vueuse/core": "14.2.1",
    "@vueuse/nuxt": "14.2.1",
    "eslint": "10.1.0",
    "execa": "9.6.1",
    "human-regex": "2.2.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "prisma": "7.7.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.6"
  }
}
